<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login - Kididee Technologies</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #0b1220;
            color: white;
            min-height: 100vh;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 8%;
            background: #111827;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        .logo span {
            color: #00aaff;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
        }

        nav a:hover {
            color: #00aaff;
        }

        .login-container {
            min-height: calc(100vh - 80px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .login-box {
            width: 100%;
            max-width: 420px;
            background: #111c32;
            padding: 40px;
            border-radius: 14px;
            border: 1px solid #1d2b45;
        }

        .login-box h1 {
            text-align: center;
            color: #00aaff;
            margin-bottom: 10px;
        }

        .login-box p {
            text-align: center;
            color: #aeb8c7;
            margin-bottom: 30px;
        }

        .input-group {
            margin-bottom: 20px;
        }

        .input-group label {
            display: block;
            margin-bottom: 8px;
            color: #dbe4f0;
        }

        .input-group input {
            width: 100%;
            padding: 14px;
            border: 1px solid #2a3b59;
            border-radius: 6px;
            background: #0b1220;
            color: white;
            outline: none;
        }

        .input-group input:focus {
            border-color: #00aaff;
        }

        .login-btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 6px;
            background: #00aaff;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        .login-btn:hover {
            background: #0088cc;
        }

        .links {
            text-align: center;
            margin-top: 25px;
        }

        .links a {
            color: #00aaff;
            text-decoration: none;
        }

        .links a:hover {
            text-decoration: underline;
        }

        .back-home {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #aeb8c7;
            text-decoration: none;
        }

        .back-home:hover {
            color: white;
        }

        @media (max-width: 600px) {
            header {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 0 7px;
                font-size: 14px;
            }

            .login-box {
                padding: 30px 20px;
            }
        }
    </style>
</head>

<body>

    <header>
        <div class="logo">
            Kididee <span>Technologies</span>
        </div>

        <nav>
            <a href="index.html">Home</a>
            <a href="about.html">About</a>
            <a href="technology.html">Technology</a>
            <a href="projects.html">Projects</a>
        </nav>
    </header>

    <div class="login-container">

        <div class="login-box">

            <h1>Welcome Back</h1>

            <p>Login to Kididee Technologies</p>

            <form onsubmit="loginUser(event)">

                <div class="input-group">
                    <label for="email">Email</label>

                    <input
                        type="email"
                        id="email"
                        placeholder="Enter your email"
                        required
                    >
                </div>

                <div class="input-group">
                    <label for="password">Password</label>

                    <input
                        type="password"
                        id="password"
                        placeholder="Enter your password"
                        required
                    >
                </div>

                <button type="submit" class="login-btn">
                    Login
                </button>

            </form>

            <div class="links">
                <p>Don't have an account?</p>
                <a href="#">Create Account</a>
            </div>

            <a href="index.html" class="back-home">
                ← Back to Home
            </a>

        </div>

    </div>

    <script>
        function loginUser(event) {
            event.preventDefault();

            alert("Login system is ready for connection.");

            window.location.href = "dashboard.html";
        }
    </script>

</body>
  </html>
